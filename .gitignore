# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Cache directories
.cache/

# Training / evaluation outputs (never commit runs)
runs/
outputs/
checkpoints/
*.ckpt
*.safetensors
*.bin
*.pt
*.pth

# Third-party benchmark files restored on demand and sha256-verified by
# scripts/restore_official_benchmarks.py (pinned in inventory_before_reorg.json)
data/code_benchmarks/official/*.jsonl

# Credentials. They live outside the repository (~/.config/opd/, ~/.config/rclone/, /content/ on the
# VM); these patterns only stop an accidental copy from being committed.
gh_credentials
*credentials*.txt
.git-credentials
hf_token
*.token
rclone.conf
.colab-drive-rclone-upload.conf
.env
.env.*

# Local logs and OS/editor noise
*.log
!reports/**/*.log
!docs/handover/**/*.log
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier
*.Zone.Identifier
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
*.orig
.idea/
.vscode/
